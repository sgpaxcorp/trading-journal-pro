{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "npm run lint:web",
    "lint:web": "eslint app context lib hooks proxy.ts tests --quiet",
    "typecheck:web": "rm -rf .next/types && next typegen && rm -f .next/lock && tsc --noEmit",
    "typecheck:mobile": "cd mobile && npx tsc --noEmit",
    "app-review:seed-demo": "node scripts/app-review/seed-demo-account.mjs",
    "release:backup": "node scripts/release/backup-supabase.mjs",
    "release:smoke": "node scripts/release/smoke-production.mjs",
    "release:test-deletion": "node scripts/release/test-account-deletion.mjs",
    "release:create-launch-coupon": "node scripts/release/create-launch-coupon.mjs",
    "release:check-config": "node scripts/release/check-config.mjs",
    "neuro:smoke-live": "node scripts/neuro-analysis/smoke-live.mjs",
    "neuro:upload-corpus": "node scripts/neuro-analysis/upload-cfa-corpus.mjs",
    "admin:bootstrap": "node supabase/manual/bootstrap_admin_user.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:mobile": "npm --prefix mobile run audit:ci",
    "verify:release": "npm run test:unit && npm run lint:web && npm run typecheck:web && npm run build && npm run typecheck:mobile && npm run audit:prod && npm run audit:mobile",
    "verify:auth-live": "node supabase/manual/check_auth_signup_health.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android"
  },
