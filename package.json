    "openai": "^6.9.1",
    "react": "19.2.0",
    "react-apexcharts": "^1.9.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
