# Core app
NEXT_PUBLIC_APP_URL=https://www.neurotrader-journal.com
NEXT_PUBLIC_SITE_URL=https://www.neurotrader-journal.com

# Supabase
# Local/dev should point to a separate Supabase project from production.
# Use the same email/password in both projects if you want one identity across environments.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin access
# Optional emergency allow-list. Primary admin state should still live in public.admin_users.
ADMIN_EMAILS=admin@example.com
SMART_TOOLS_OWNER_EMAILS=
SMART_TOOLS_CLOSED_BETA=true

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Core: $19.99/month and $199.90/year.
STRIPE_PRICE_CORE_MONTHLY=price_xxx
STRIPE_PRICE_CORE_ANNUAL=price_xxx
# Advanced: $39.99/month and $399.90/year.
STRIPE_PRICE_ADVANCED_MONTHLY=price_xxx
STRIPE_PRICE_ADVANCED_ANNUAL=price_xxx
STRIPE_PRICE_OPTIONFLOW_MONTHLY=price_xxx
STRIPE_PRICE_OPTIONFLOW_ANNUAL=price_xxx
STRIPE_PRICE_BROKER_SYNC_MONTHLY=price_xxx
STRIPE_PRICE_BROKER_SYNC_ANNUAL=price_xxx
STRIPE_TESTER_PROMO_CODES=

# OpenAI
OPENAI_API_KEY=sk_xxx
# Organization Admin API key used only by the Admin cost reconciliation panel.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_OPTIONFLOW_MODEL=gpt-4.1
OPENAI_OPTIONFLOW_VISION_MODEL=gpt-4o
OPENAI_OPTIONFLOW_CHAT_MODEL=gpt-4.1
AI_COACH_OPENAI_API_KEY=
AI_COACH_OPENAI_BASE_URL=
AI_COACH_MODEL=gpt-4o-mini
AI_COACH_VISION_MODEL=gpt-4o
OPENAI_GROWTH_PLAN_MODEL=gpt-5.6-sol

# Email / contact
RESEND_API_KEY=re_xxx 
RESEND_FROM_EMAIL=Neuro Trader <support@neurotrader-journal.com>
# Development preview uses an in-memory waitlist by default so local tests do not write to production data.
WAITLIST_USE_SUPABASE_IN_DEV=false
# Optional: send real Resend emails while testing the in-memory waitlist locally.
WAITLIST_SEND_EMAILS_IN_DEV=false
# Optional launch-day waitlist discount email settings.
WAITLIST_ANNUAL_PROMO_CODE=
WAITLIST_ANNUAL_PROMO_URL=

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key

# Scheduled jobs
CRON_SECRET=generate_a_long_random_secret

# Market data
TRADING_ECONOMICS_API_KEY=

# Feature flags / entitlements
OPTIONFLOW_PAYWALL_ENABLED=true
OPTIONFLOW_BYPASS_ENTITLEMENT=false
OPTIONFLOW_INCLUDE_SCREENSHOTS_LLM=false
NEXT_PUBLIC_OPTIONFLOW_PAYWALL_ENABLED=true
NEXT_PUBLIC_OPTIONFLOW_BYPASS=false
BROKER_SYNC_FREE=false
NEXT_PUBLIC_BROKER_SYNC_FREE=false
# Keep direct broker OAuth/API sync disabled until SnapTrade/Webull approvals are complete.
BROKER_CONNECTIONS_ENABLED=false
NEXT_PUBLIC_BROKER_CONNECTIONS_ENABLED=false

# SnapTrade
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key

# Webull OAuth
WEBULL_CLIENT_ID=
WEBULL_CLIENT_SECRET=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REDIRECT_URI=https://www.neurotrader-journal.com/api/webull/callback
WEBULL_ENV=prod
WEBULL_SCOPE=
WEBULL_AUTH_BASE=
WEBULL_API_BASE=
WEBULL_API_PREFIX=/oauth-openapi
WEBULL_SIGN_REQUESTS=true
WEBULL_PATH_ORDERS=/order/list
WEBULL_PATH_BALANCES=/asset/balance
WEBULL_PATH_POSITIONS=/asset/position
WEBULL_PATH_ACTIVITIES=/account/activities
